{
  "openapi": "3.0.3",
  "info": {
    "title": "Transaction Ledger API",
    "version": "1.0.0",
    "description": "Accounts, credit/debit transactions, balances, paginated history and atomic money transfers. All amounts are decimal numbers with at most 2 decimal places. Every error uses the same envelope: `{ success: false, error: { code, message, details? } }`."
  },
  "servers": [{ "url": "http://localhost:3000", "description": "Local" }],
  "tags": [
    { "name": "Accounts" },
    { "name": "Transactions" },
    { "name": "Transfers", "description": "Bonus feature" },
    { "name": "Health" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check (server + database)",
        "responses": {
          "200": { "description": "Healthy", "content": { "application/json": { "example": { "success": true, "data": { "status": "ok", "database": "connected" } } } } },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/accounts": {
      "post": {
        "tags": ["Accounts"],
        "summary": "Create an account",
        "description": "Only `name` is accepted. `id`, `balance` (always 0) and `created_at` are generated by the server; sending any other field is rejected with 400.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAccountRequest" }, "example": { "name": "Alice" } } }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "headers": { "Location": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean", "example": true }, "data": { "$ref": "#/components/schemas/Account" } } } } }
          },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "tags": ["Accounts"],
        "summary": "Get an account",
        "parameters": [{ "$ref": "#/components/parameters/accountId" }],
        "responses": {
          "200": { "description": "Account", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Account" } } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/accounts/{accountId}/balance": {
      "get": {
        "tags": ["Accounts"],
        "summary": "Get the current balance",
        "parameters": [{ "$ref": "#/components/parameters/accountId" }],
        "responses": {
          "200": {
            "description": "Balance",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Balance" } } } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/accounts/{accountId}/transactions": {
      "post": {
        "tags": ["Transactions"],
        "summary": "Add a credit or debit transaction",
        "description": "Atomically records the transaction and updates the balance. Debits that exceed the balance are rejected (422). A `reference_id` already used on this account returns 409 with the existing transaction and changes nothing.",
        "parameters": [{ "$ref": "#/components/parameters/accountId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTransactionRequest" }, "example": { "type": "credit", "amount": 100, "description": "Salary", "reference_id": "INV-1001" } } }
        },
        "responses": {
          "201": {
            "description": "Transaction created",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object", "properties": { "transaction": { "$ref": "#/components/schemas/Transaction" }, "balance": { "type": "number", "example": 150 } } } } } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      },
      "get": {
        "tags": ["Transactions"],
        "summary": "Transaction history (filter, paginate, latest first)",
        "parameters": [
          { "$ref": "#/components/parameters/accountId" },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["credit", "debit"] }, "description": "Omit to return both types" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "A page of transactions, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" },
                    "filters": { "type": "object", "properties": { "type": { "type": "string", "nullable": true, "enum": ["credit", "debit", null] } } }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/accounts/{accountId}/transactions/{transactionId}": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Get a single transaction",
        "parameters": [{ "$ref": "#/components/parameters/accountId" }, { "$ref": "#/components/parameters/transactionId" }],
        "responses": {
          "200": { "description": "Transaction", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Transaction" } } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": { "tags": ["Transactions"], "summary": "Not allowed - transactions are immutable", "parameters": [{ "$ref": "#/components/parameters/accountId" }, { "$ref": "#/components/parameters/transactionId" }], "responses": { "405": { "$ref": "#/components/responses/Error" } } },
      "patch": { "tags": ["Transactions"], "summary": "Not allowed - transactions are immutable", "parameters": [{ "$ref": "#/components/parameters/accountId" }, { "$ref": "#/components/parameters/transactionId" }], "responses": { "405": { "$ref": "#/components/responses/Error" } } },
      "delete": { "tags": ["Transactions"], "summary": "Not allowed - transactions are immutable", "parameters": [{ "$ref": "#/components/parameters/accountId" }, { "$ref": "#/components/parameters/transactionId" }], "responses": { "405": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/transfers": {
      "post": {
        "tags": ["Transfers"],
        "summary": "Transfer money between two accounts (atomic)",
        "description": "Debits the source and credits the destination in one database transaction; any failure rolls back both. Both legs are recorded as transactions sharing a `transfer_id` and the same `reference_id`, so the reference must be unused on both accounts.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTransferRequest" }, "example": { "from_account_id": "8f1c9a52-4f0e-4b0a-9d55-2f3c1a7e6b11", "to_account_id": "2b7d0e44-9a61-4c7e-8f2a-5d1e3c9b7a22", "amount": 30, "description": "Rent share", "reference_id": "TRF-001" } } }
        },
        "responses": {
          "201": { "description": "Transfer completed", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Transfer" } } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "accountId": { "name": "accountId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "transactionId": { "name": "transactionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Error": {
        "description": "Error (see `error.code`)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "CreateAccountRequest": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 255 } }
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "Alice" },
          "balance": { "type": "number", "example": 0 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Balance": {
        "type": "object",
        "properties": { "account_id": { "type": "string", "format": "uuid" }, "balance": { "type": "number", "example": 100 } }
      },
      "CreateTransactionRequest": {
        "type": "object",
        "required": ["type", "amount", "reference_id"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["credit", "debit"] },
          "amount": { "type": "number", "exclusiveMinimum": true, "minimum": 0, "maximum": 1000000000, "description": "> 0, at most 2 decimal places, must be a JSON number" },
          "description": { "type": "string", "maxLength": 500, "nullable": true },
          "reference_id": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Unique per account" }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "account_id": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "enum": ["credit", "debit"] },
          "amount": { "type": "number", "example": 100 },
          "description": { "type": "string", "nullable": true },
          "reference_id": { "type": "string", "example": "INV-1001" },
          "transfer_id": { "type": "string", "format": "uuid", "nullable": true, "description": "Set only for transfer legs" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 10 },
          "total_records": { "type": "integer", "example": 42 },
          "total_pages": { "type": "integer", "example": 5 },
          "has_next_page": { "type": "boolean" },
          "has_previous_page": { "type": "boolean" }
        }
      },
      "CreateTransferRequest": {
        "type": "object",
        "required": ["from_account_id", "to_account_id", "amount", "reference_id"],
        "additionalProperties": false,
        "properties": {
          "from_account_id": { "type": "string", "format": "uuid" },
          "to_account_id": { "type": "string", "format": "uuid" },
          "amount": { "type": "number", "minimum": 0, "exclusiveMinimum": true, "maximum": 1000000000 },
          "description": { "type": "string", "maxLength": 500, "nullable": true },
          "reference_id": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "transfer_id": { "type": "string", "format": "uuid" },
          "amount": { "type": "number" },
          "reference_id": { "type": "string" },
          "from_account": { "$ref": "#/components/schemas/Balance" },
          "to_account": { "$ref": "#/components/schemas/Balance" },
          "transactions": {
            "type": "object",
            "properties": { "debit": { "$ref": "#/components/schemas/Transaction" }, "credit": { "$ref": "#/components/schemas/Transaction" } }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR", "INVALID_JSON", "INVALID_ACCOUNT_ID", "INVALID_TRANSACTION_TYPE", "INVALID_AMOUNT",
                  "INVALID_PAGINATION", "ACCOUNT_NOT_FOUND", "TRANSACTION_NOT_FOUND", "INSUFFICIENT_BALANCE",
                  "DUPLICATE_TRANSACTION", "METHOD_NOT_ALLOWED", "ROUTE_NOT_FOUND", "PAYLOAD_TOO_LARGE",
                  "SERVICE_UNAVAILABLE", "INTERNAL_SERVER_ERROR"
                ]
              },
              "message": { "type": "string" },
              "details": { "description": "Array of field errors for validation errors, or an object with context (e.g. current_balance, the existing transaction)" }
            }
          }
        },
        "example": { "success": false, "error": { "code": "INSUFFICIENT_BALANCE", "message": "Insufficient balance for this debit", "details": { "account_id": "8f1c9a52-4f0e-4b0a-9d55-2f3c1a7e6b11", "current_balance": 100, "requested_amount": 150 } } }
      }
    }
  }
}
