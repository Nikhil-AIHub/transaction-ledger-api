# Copy this file to .env and replace YOUR_PASSWORD with your PostgreSQL password.
# Use a password without special characters such as @ # % / (or URL-encode them).

# Port the API listens on
PORT=3000

# Main database used by `npm start` / `npm run dev` / `npm run db:migrate`
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ledger_db

# Separate database used by `npm test` (tests empty its tables before running)
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ledger_test
